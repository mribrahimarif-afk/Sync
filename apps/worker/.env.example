# Sync worker - safe example values only. Copy to `.env` for local development.
# `npm run dev:worker` loads apps/worker/.env if present. The compiled `npm run start:worker`
# does NOT read .env files: provide these as real environment variables
# (or run `node --env-file=.env dist/main.js` from apps/worker).
#
# The worker currently connects to no database, queue or provider, so there are no
# secrets or connection settings. Durable job processing is not implemented yet.

# development | test | production. Defaults to development.
NODE_ENV=development

# fatal | error | warn | info | debug | trace | silent. Defaults to info.
LOG_LEVEL=info
