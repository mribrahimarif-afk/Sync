# Sync API - safe example values only. Copy to `.env` for local development.
# `npm run dev:api` loads apps/api/.env if present. The compiled `npm run start:api`
# does NOT read .env files: provide these as real environment variables
# (or run `node --env-file=.env dist/main.js` from apps/api).

# development | test | production. Defaults to development.
NODE_ENV=development

# Interface to bind. Defaults to 127.0.0.1 (local only). Use 0.0.0.0 inside a container/server.
HOST=127.0.0.1
PORT=4000

# fatal | error | warn | info | debug | trace | silent. Defaults to info.
LOG_LEVEL=info

# Comma-separated browser origins allowed to call the API (scheme + host + port,
# no path, no trailing slash, no wildcard).
# Development default: http://localhost:3000,http://127.0.0.1:3000
# REQUIRED when NODE_ENV=production (for example https://app.example.com).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For header may be trusted.
# Leave unset when the API is not behind a proxy: forwarded headers are then ignored.
# TRUSTED_PROXIES=10.0.0.0/8

# Maximum request body size in bytes (1024 - 10485760). Defaults to 1048576 (1 MiB).
BODY_LIMIT_BYTES=1048576

# Per-client request budget: RATE_LIMIT_MAX requests per RATE_LIMIT_WINDOW_SECONDS.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_SECONDS=60
