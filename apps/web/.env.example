# Sync web - safe example values only. Copy to `.env.local` for local development.
#
# Only NEXT_PUBLIC_ variables reach the browser, and they are inlined at BUILD time:
# never put secrets in them, and rebuild after changing them.

# Origin of the Sync API as seen from the user's browser (no trailing path needed).
# Defaults to http://localhost:4000 when unset.
# Production builds should set this explicitly to the deployed API origin, and that API must
# list the web origin in its CORS_ALLOWED_ORIGINS.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
